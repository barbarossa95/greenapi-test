{
  "name": "greenapi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:router": "react-router typegen",
    "dev": "react-router dev --port 3000",
    "build": "tsc -b && react-router build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "analyze": "vite build --mode analyze",
    "format": "prettier --write ./",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,md,mdx,json,css,yaml}\"",
    "prettier:format": "prettier --write \"**/*.{ts,tsx,js,md,mdx,json,css,yaml}\"",
    "test": "pnpm typecheck && pnpm prettier:check && pnpm lint",
    "unit": "vitest",
    "unit:ui": "vitest --ui",
    "unit:run": "vitest run",
    "unit:coverage": "vitest run --coverage",
    "integration": "playwright test",
    "integration:ui": "playwright test --ui",
    "integration:debug": "playwright test --debug",
    "integration:headed": "playwright test --headed",
    "integration:report": "playwright show-report"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm test"
    ]
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ant-design/x": "^2.9.0",
    "@emoji-mart/data": "^1.2.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.6.5",
    "antd-phone-input": "^0.3.20",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "emoji-mart": "^5.6.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "nuqs": "^2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "superjson": "^2.2.6",
    "vite-plugin-svgr": "^5.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/config-inspector": "3.5.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "^5.0.3",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-project-structure": "^3.14.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.8.1"
}
